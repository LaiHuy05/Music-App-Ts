PORT=3000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/music-app
APP_URL=http://localhost:3000
# Đặt một chuỗi ngẫu nhiên dài; bắt buộc khi chạy production.
SESSION_SECRET=

# Dùng tên biến Cloudinary đang có trong dự án.
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# SMTP để gửi liên kết quên mật khẩu (không gửi token ra giao diện/log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Chỉ dùng khi chạy npm run seed:admin. Không có mật khẩu admin mặc định.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chỉ cấu hình nếu ứng dụng nằm sau reverse proxy đáng tin cậy.
# TRUST_PROXY=1
