include ../../shared/forms.pug
doctype html
html(lang="vi")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="csrf-token" content=csrfToken)
    title #{pageTitle} - #{settings.websiteName}
    link(rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet" href="/vendor/fontawesome/css/all.min.css")
    link(rel="stylesheet" href="/vendor/aplayer/APlayer.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body
    include ../partials/header.pug
    main.main
      if message
        .container.mt-3
          .alert.alert-success(role="status")= message
      block main
    include ../partials/footer.pug
    script(src="/vendor/jquery/jquery.slim.min.js")
    script(src="/vendor/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/vendor/aplayer/APlayer.min.js")
    script(src="/js/script.js")
