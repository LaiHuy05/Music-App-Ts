extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main 
  .container.my-3
    .row 
      .col-12
        +box-head(pageTitle)

    .row
      each topic in topics
        .col-md-6.col-12.mb-3
          .card
            img(src=topic.avatar || settings.logo alt=topic.title loading="lazy")
            .card-body
              h5.card-title #{topic.title}
              .card-text!= topic.description
              a.btn.btn-primary(href=`/songs/${topic.slug}`) Xem chi tiết
