extends ../../layouts/default.pug

block main
  .singer-detail
    .container.my-4
      h1.inner-title= song.title
      .inner-actions
        .inner-action.inner-time
          i.fa-regular.fa-clock(aria-hidden="true")
          |  #{song.createdAt ? new Date(song.createdAt).toLocaleDateString("vi-VN") : ""}
        .inner-action.inner-singer
          i.fa-solid.fa-microphone-lines(aria-hidden="true")
          |  #{singer.fullName}
        .inner-action.inner-topic
          i.fa-solid.fa-music(aria-hidden="true")
          |  #{topic.title}
        .inner-action.inner-listen
          i.fa-solid.fa-headphones(aria-hidden="true")
          span  #{song.listen} lượt nghe
        button.inner-action.inner-like(type="button" class=song.isLiked ? "active" : "" button-like=song.id aria-pressed=song.isLiked)
          i.fa-regular.fa-thumbs-up(aria-hidden="true")
          span  #{song.like} thích
        button.inner-action.inner-heart(type="button" class=song.isFavoriteSong ? "active" : "" button-favorite=song.id aria-pressed=song.isFavoriteSong)
          i.fa-regular.fa-heart(aria-hidden="true")
          |  Bài hát yêu thích
      .inner-play
        .inner-avatar
          img(src=song.avatar || settings.logo alt=song.title)
        .inner-audio
          #aplayer(data-song=song data-singer=singer)
          audio(controls src=song.audio data-native-player hidden)
      .inner-desc
        .inner-label Mô tả
        .inner-text!= song.description
      .inner-desc
        .inner-label Lời bài hát
        pre.inner-text.lyrics= song.lyrics
