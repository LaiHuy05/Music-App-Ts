extends ../../layouts/default.pug

block main
  .container.my-4
    .client-auth.card.card-body
      h1.h3.mb-3 Đặt lại mật khẩu
      form(action=`/user/password/reset/${token}` method="POST")
        +csrfField()
        +field("password", "Mật khẩu mới", "", "password", true)
        +field("confirmPassword", "Nhập lại mật khẩu mới", "", "password", true)
        button.btn.btn-primary.btn-block(type="submit") Đặt lại mật khẩu
