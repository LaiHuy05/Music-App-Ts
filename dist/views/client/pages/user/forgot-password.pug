extends ../../layouts/default.pug

block main
  .container.my-4
    .client-auth.card.card-body
      h1.h3.mb-3 Quên mật khẩu
      p Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu.
      form(action="/user/password/forgot" method="POST")
        +csrfField()
        +field("email", "Email", "", "email", true)
        button.btn.btn-primary.btn-block(type="submit") Gửi hướng dẫn
      a.mt-3(href="/user/login") Quay lại đăng nhập
