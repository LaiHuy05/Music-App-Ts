extends ../../layouts/default.pug
include ../../mixins/song-card.pug

block main
  .container.my-4
    h1.h3.mb-4= pageTitle
    p.text-muted(data-favorite-empty hidden=!!favoriteSongs.length) Bạn chưa lưu bài hát yêu thích nào.
    .row
      each item in favoriteSongs
        +songCard(item.infoSong, true)
