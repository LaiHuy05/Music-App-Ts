header.header
  .container-fluid
    .row.align-items-center
      .col-4
        .inner-logo
          a(href=`/${prefixAdmin}`) #{settings.websiteName} · Admin
      .col-8.text-right
        a.btn.btn-outline-light.btn-sm.mr-2(href="/" target="_blank" rel="noopener") Xem website
        a.btn.btn-primary.btn-sm.mr-2(href=`/${prefixAdmin}/my-account`)= currentAdmin.fullName
        form.d-inline(action=`/${prefixAdmin}/auth/logout` method="POST")
          +csrfField()
          button.btn.btn-danger.btn-sm(type="submit") Đăng xuất
