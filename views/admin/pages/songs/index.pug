extends ../../layouts/default.pug

block main
  h1= pageTitle
  .card.card-body
    .d-flex.justify-content-between.flex-wrap
      +filters(`/${prefixAdmin}/songs`)
      if can("songs_create")
        a.btn.btn-outline-success.mb-3(href=`/${prefixAdmin}/songs/create`) + Thêm mới
    .table-responsive
      table.table.table-hover
        thead
          tr
            th STT
            th Ảnh
            th Tiêu đề
            th Thích / Nghe
            th Trạng thái
            th Hành động
        tbody
          if !songs.length
            tr: td(colspan="6") Chưa có bài hát.
          each item, index in songs
            tr
              td= index + 1
              td: img.table-avatar(src=item.avatar || settings.logo alt=item.title)
              td= item.title
              td #{item.like} / #{item.listen}
              td
                if can("songs_edit")
                  +statusForm(`/${prefixAdmin}/songs/status/${item.id}`, item.status)
                else
                  span= item.status === "active" ? "Hoạt động" : "Dừng hoạt động"
              td
                a.btn.btn-secondary.btn-sm(href=`/${prefixAdmin}/songs/detail/${item.id}`) Chi tiết
                if can("songs_edit")
                  a.btn.btn-warning.btn-sm.ml-1(href=`/${prefixAdmin}/songs/edit/${item.id}`) Sửa
                if can("songs_delete")
                  +deleteForm(`/${prefixAdmin}/songs/delete/${item.id}`)
