form.card.card-body(action=(song ? `/${prefixAdmin}/songs/edit/${song.id}?_method=PATCH` : `/${prefixAdmin}/songs/create`) method="POST" enctype="multipart/form-data")
  +csrfField()
  +field("title", "Tiêu đề", song && song.title, "text", true)
  .form-group
    label(for="topicId") Chủ đề
    select.form-control(name="topicId" id="topicId" required)
      option(value="") -- Chọn chủ đề --
      each topic in topics
        option(value=topic.id selected=!!song && song.topicId === topic.id) #{topic.title}#{topic.status === "inactive" ? " (dừng hoạt động)" : ""}
  .form-group
    label(for="singerId") Ca sĩ
    select.form-control(name="singerId" id="singerId" required)
      option(value="") -- Chọn ca sĩ --
      each singer in singers
        option(value=singer.id selected=!!song && song.singerId === singer.id) #{singer.fullName}#{singer.status === "inactive" ? " (dừng hoạt động)" : ""}
  .form-group(upload-image)
    label(for="avatar") Ảnh
    input.form-control-file(type="file" name="avatar" id="avatar" accept="image/jpeg,image/png,image/webp,image/gif" upload-image-input)
    img.image-preview(src=song ? (song.avatar || settings.logo) : settings.logo alt="Ảnh xem trước" upload-image-preview)
  +field("avatarUrl", "Hoặc nhập URL ảnh", "", "url")
  .form-group(upload-audio)
    label(for="audio") File âm thanh (tối đa 30 MB)
    input.form-control-file(type="file" name="audio" id="audio" accept="audio/*" upload-audio-input)
    audio.mt-2(controls upload-audio-play)
      source(src=song ? song.audio : "")
  +field("audioUrl", "Hoặc nhập URL âm thanh", "", "url")
  if song
    p.text-muted Để trống tệp và URL nếu muốn giữ ảnh, âm thanh hiện tại.
  .form-group
    label(for="lyrics") Lời bài hát (hỗ trợ LRC)
    textarea.form-control(id="lyrics" name="lyrics" rows="12")= song ? song.lyrics : ""
  .form-group
    label(for="description") Mô tả
    textarea.form-control(id="description" name="description" rows="5" textarea-mce)= song ? song.description : ""
  +statusField(song ? song.status : "active")
  .form-group.mb-0
    button.btn.btn-primary(type="submit") Lưu
    a.btn.btn-secondary.ml-2(href=`/${prefixAdmin}/songs`) Quay lại
