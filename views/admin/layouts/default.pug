include ../../shared/forms.pug
doctype html
html(lang="vi")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="csrf-token" content=csrfToken)
    meta(name="admin-prefix" content=prefixAdmin)
    title #{pageTitle} - #{settings.websiteName}
    link(rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css")
    link(rel="stylesheet" href="/admin/css/style.css")
  body
    include ../partials/header.pug
    .body
      include ../partials/sider.pug
      main.main
        if message
          .alert.alert-success(role="status")= message
        block main
    script(src="/vendor/jquery/jquery.slim.min.js")
    script(src="/vendor/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/tinymce/tinymce.min.js")
    script(src="/admin/js/tinymce-config.js")
    script(src="/admin/js/script.js")
