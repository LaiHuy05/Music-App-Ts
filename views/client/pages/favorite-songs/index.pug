extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main 
  .container.my-3 
    .row 
      .col-12 
        +box-head(pageTitle)

    .row
      each item in favoriteSongs
        .col-6.mb-3
          .song-item
            .inner-image
              a(href=`/songs/detail/${item.infoSong.slug}`)
                img(src=item.infoSong.avatar, alt=item.infoSong.title)
            .inner-content
              .inner-title
                a(href=`/songs/detail/${item.infoSong.slug}`) #{item.infoSong.title}
              .inner-singer
                i.fa-solid.fa-microphone-lines
                |  #{item.infoSinger.fullName}
              .inner-heart.active(button-favorite=item.songId)
                i.fa-regular.fa-heart
                |  Yêu thích
              .inner-time
                i.fa-regular.fa-clock
                |  Hôm nay

        