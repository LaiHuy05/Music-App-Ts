header.header
  .container
    .row.align-items-center
      .col-lg-2.col-12
        .inner-logo
          a(href="/" aria-label=settings.websiteName)
            img(src=settings.logo alt=settings.websiteName)
      .col-lg-4.col-12.my-2
        .box-search
          form(action="/search/result" method="GET")
            .form-group.d-flex.mb-0
              input.form-control(type="search" placeholder="Tìm bài hát..." name="keyword" value=keyword maxlength="100" aria-label="Tìm bài hát" autocomplete="off")
              button.btn.btn-primary(type="submit") Tìm
          .inner-suggest
            .inner-list
      .col-lg-6.col-12
        nav.inner-menu(aria-label="Menu chính")
          ul
            li: a(href="/") Trang chủ
            li: a(href="/topics") Chủ đề
            li: a(href="/favorite-songs") Yêu thích
            if currentUser
              li: a(href="/user/info")= currentUser.fullName
              li
                form(action="/user/logout" method="POST")
                  +csrfField()
                  button.nav-logout(type="submit") Đăng xuất
            else
              li: a(href="/user/login") Đăng nhập
              li: a(href="/user/register") Đăng ký
