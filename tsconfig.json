{
  "compilerOptions": {
    "target": "es2020", // biên dịch sang phiên bản ES2020
    "module": "commonjs", // sử dụng module commonjs là tiêu chuẩn sử dụng trong Node.js để làm việc với các module
    "removeComments": true, // loại bỏ các comment trong quá trình biên dịch sang js
    "esModuleInterop": true ,// dùng từ khoá import để thay cho require 
    "outDir": "dist", // thư mục chứa file js sau khi biên dịch
    "noEmitOnError": true
  },
  "exclude": ["node_modules", "dist"]
}
